# ============================================
# Aria SAT Tutor Agent — Environment Config
# ============================================
# Copy this file to .env and fill in your values

# --- LLM provider (needed only to BUILD the question bank and to warm
#     outreach phrasing; the demo, simulator and planner run with neither) ---
GROQ_API_KEY=your_groq_api_key_here

# Azure OpenAI. Set the endpoint AND key to use Azure instead of Groq --
# bank_build switches automatically. Groq's free tier meters tokens-per-day
# per model, which stalls a full bank build partway through.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21
# Deployment names you chose in Azure, not model names.
AZURE_DEPLOYMENT_MATH=
AZURE_DEPLOYMENT_RW=
AZURE_DEPLOYMENT_VERIFIER=

# --- Google Sheets ---
GOOGLE_CREDENTIALS_PATH=C:\path\to\your-service-account-key.json
SPREADSHEET_ID=your_google_sheet_id_here
SHEET_NAME=Sheet1

# --- WhatsApp ---
# Nothing to configure. whatsapp.py spawns whatsapp-bridge.js, which links to
# WhatsApp Web by QR on first run and caches the session in .wwebjs_auth/.

# --- Scheduling ---
POLL_INTERVAL_MINUTES=2
SCHEDULE_INTERVAL_HOURS=6

# --- Paths ---
DB_PATH=reminders.db
CHROMA_DB_PATH=./chroma_db
